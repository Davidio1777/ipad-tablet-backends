<Window x:Class="IPadTablet.Backend.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPad Tablet Backend" Width="760" Height="760" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="iPad Tablet Backend" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Encrypted UDP, optional USB, and automatic OpenTabletDriver setup"
                 Foreground="Gray" Margin="0,4,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Connection" Margin="0,0,0,12">
          <Grid Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="UdpEnabled" Content="Encrypted UDP" IsChecked="True" Margin="0,7" />
            <PasswordBox x:Name="TokenBox" Grid.Column="1" Margin="8,3" MinWidth="280" />
            <Button Grid.Column="2" Content="Generate token" Click="GenerateToken_Click" Padding="10,5" Margin="8,3,0,3" />
            <CheckBox x:Name="UsbEnabled" Grid.Row="1" Content="USB via iproxy" Margin="0,7" />
            <TextBox x:Name="IproxyBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="iproxy.exe" Margin="8,3,0,3" />
            <TextBlock Grid.Row="2" Text="UDP video/input ports" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,3">
              <TextBox x:Name="VideoPortBox" Text="8766" Width="80" />
              <TextBox x:Name="InputPortBox" Text="8767" Width="80" Margin="8,0,0,0" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="Capture and encoding" Margin="0,0,0,12">
          <Grid Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Encoder" VerticalAlignment="Center" />
            <ComboBox x:Name="EncoderBox" Grid.Column="1" SelectedIndex="0" Margin="8,3">
              <ComboBoxItem Content="auto" /><ComboBoxItem Content="h264_amf" />
              <ComboBoxItem Content="h264_nvenc" /><ComboBoxItem Content="h264_qsv" />
              <ComboBoxItem Content="libx264" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Source X / Y" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,3">
              <TextBox x:Name="SourceXBox" Text="0" Width="100" />
              <TextBox x:Name="SourceYBox" Text="0" Width="100" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Source width / height" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,3">
              <TextBox x:Name="SourceWidthBox" Text="2560" Width="100" />
              <TextBox x:Name="SourceHeightBox" Text="1440" Width="100" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Stream width / height" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,3">
              <TextBox x:Name="WidthBox" Text="1280" Width="100" />
              <TextBox x:Name="HeightBox" Text="720" Width="100" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="FPS / bitrate / rate" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="8,3">
              <TextBox x:Name="FpsBox" Text="120" Width="70" />
              <TextBox x:Name="BitrateBox" Text="8000000" Width="120" Margin="8,0,0,0" />
              <ComboBox x:Name="RateBox" SelectedIndex="0" Width="90" Margin="8,0,0,0">
                <ComboBoxItem Content="cbr" /><ComboBoxItem Content="vbr" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="OpenTabletDriver" Margin="0,0,0,12">
          <Grid Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <CheckBox x:Name="OtdEnabled" Content="Automatic setup" IsChecked="True" Margin="0,7" />
            <TextBox x:Name="OtdCliBox" Grid.Column="1" Text="otd.exe" Margin="8,3" />
            <TextBlock Grid.Row="1" Text="Tablet name" VerticalAlignment="Center" />
            <TextBox x:Name="OtdTabletBox" Grid.Row="1" Grid.Column="1"
                     Text="Apple iPad Pro (Apple Pencil)" Margin="8,3" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Backend log">
          <TextBox x:Name="LogBox" Margin="8" Height="180" IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Text="Stopped" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,16,0" />
      <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" Padding="20,8" />
      <Button x:Name="StartButton" Content="Start backend" Click="Start_Click" Padding="20,8" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
